# 飞书多维表格配置（示例模板，请勿填写真实密钥，真实值放在 .env）
# ====================
# 飞书应用 ID
FEISHU_APP_ID=your_feishu_app_id

# 飞书应用 Secret
FEISHU_APP_SECRET=your_feishu_app_secret

# 多维表格的 app_token
FEISHU_APP_TOKEN=your_feishu_app_token

# 库存表ID
FEISHU_INVENTORY_TABLE_ID=your_inventory_table_id

# 区位表ID
FEISHU_LOCATION_TABLE_ID=your_location_table_id

# 销售表ID
FEISHU_SALES_TABLE_ID=your_sales_table_id

# 沙箱环境变量（自动提供，无需配置）
# ====================
# COZE_WORKSPACE_PATH - 项目工作目录
# COZE_PROJECT_DOMAIN_DEFAULT - 对外访问域名
# DEPLOY_RUN_PORT - 服务监听端口（默认5000）
# COZE_PROJECT_ENV - 环境（DEV/PROD）
